# 凭据模板 — 复制为 secrets.env 或 Hermes profile .env（切勿提交真实值）
# 推荐生产：Bitwarden / 1Password / 短时 OIDC 令牌；假定 Agent 进程环境可被注入后读走。

# ── 网关授权（生产必填其一；禁止 GATEWAY_ALLOW_ALL_USERS=true）──────
# GATEWAY_ALLOWED_USERS=
# TELEGRAM_ALLOWED_USERS=
# DISCORD_ALLOWED_USERS=

# ── 严禁生产启用 ──────────────────────────────────────────────────
# HERMES_YOLO_MODE=1

# ── observe profile 写保护（可选但强烈建议）────────────────────────
# HERMES_WRITE_SAFE_ROOT=/tmp/themis-observe-writes-blocked

# ── SSH ───────────────────────────────────────────────────────────
SSH_DEFAULT_USER=
SSH_DEFAULT_PASS=

# ── 数据库 / 缓存 / MQ / 监控 / Webhook / 对象存储 ────────────────
# DB_<NAME>_USER=
# DB_<NAME>_PASS=
# CACHE_<NAME>_PASS=
# MQ_<NAME>_USER=
# MQ_<NAME>_PASS=
# MON_<NAME>_USER=
# MON_<NAME>_PASS=
# WEBHOOK_SECRET=
# STORAGE_<NAME>_ACCESS_KEY=
